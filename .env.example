# Sao chép file này thành .env rồi điền giá trị thật
NODE_ENV=development
PORT=5000

# MongoDB (local hoặc MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/exam_platform

# Chuỗi bí mật để ký JWT (dài, ngẫu nhiên). Ví dụ tạo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-bi-mat-that-dai
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Các origin của frontend được phép gọi API (ngăn cách bằng dấu phẩy, không có dấu / ở cuối)
# Phần tử đầu tiên được dùng để tạo link "đặt lại mật khẩu"
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Cho phép nộp trễ tối đa N giây sau khi hết giờ (bù độ trễ mạng). Quá mức này, server chấm theo đáp án đã lưu tự động.
SUBMIT_GRACE_SECONDS=15

# Tài khoản admin đầu tiên (dùng cho: npm run seed)
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345

# SMTP gửi mail quên mật khẩu (bỏ trống thì dev sẽ in link ra console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Luyện thi Online <no-reply@example.com>"
